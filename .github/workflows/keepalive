name: Keep Alive
on:
  schedule:
    - cron: '0 0 */50 * *'
jobs:
  keepalive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - run: |
          git config user.name "bot"
          git config user.email "bot@bot.com"
          echo "$(date)" > last_active.txt
          git add .
          git commit -m "keep alive" || exit 0
          git push
